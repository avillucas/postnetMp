# Copiar a .env.local y completar. .env.local NO se versiona.
#   cp .env.local.example .env.local

# --- Mercado Pago (credenciales de prueba de la aplicación) ---
# Access token de prueba del usuario vendedor de test.
MP_ACCESS_TOKEN=
# Terminal Point a la que se envían las órdenes, p. ej. NEWLAND_N950__N950NCB801293324
MP_TERMINAL_ID=
# Clave secreta de Webhooks (Tus integraciones > Webhooks) para validar x-signature.
MP_WEBHOOK_SECRET=

# --- Servicio Gestor ---
MP_API_BASE_URL=https://api.mercadopago.com
MP_ORDER_EXPIRATION=PT10M
MP_PRINT_ON_TERMINAL=no_ticket
MP_TIMEOUT_SECONDS=10
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO

# --- Simulador de Máquina ---
# En false acepta webhooks sin firma (solo para pruebas manuales locales).
WEBHOOK_SIGNATURE_REQUIRED=true
DISPENSE_PULSE_MS=500
TRANSACTION_LOG_PATH=/data/transactions.jsonl
